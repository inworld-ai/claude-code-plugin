{
  "mcpServers": {
    "inworld": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/start.mjs"
      ],
      "env": {
        "INWORLD_PLUGIN_API_KEY": "${user_config.api_key}",
        "INWORLD_MCP_TOOLSET": "runtime",
        "INWORLD_CLIENT_SOURCE": "claude-code-plugin"
      }
    },
    "voice-lab": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/voice-lab/server.mjs"
      ],
      "env": {
        "INWORLD_PLUGIN_API_KEY": "${user_config.api_key}",
        "INWORLD_CLIENT_SOURCE": "claude-code-plugin",
        "INWORLD_VOICE_LAB_BUTTONS": "1"
      }
    }
  }
}
